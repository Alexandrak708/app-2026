# Local tooling only — NOT used by the mobile app at runtime.
# The app reads its public Supabase URL + publishable key from lib/supabase.ts.
#
# Copy this file to .env.local and fill in real values for the CLI scripts
# under ./scripts. NEVER commit .env.local. The SERVICE ROLE key is a full
# admin credential — keep it server-side only (Supabase Edge Function secrets),
# never in the app bundle.

# Supabase (server-side scripts / Edge Functions only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Third-party research tooling (scripts only)
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
