      "degree": "Бакалавър и Магистър",
      "tuitionRange": "€245 - €1,350 / семестър (държавна поръчка и платен прием)",
      "website": "https://www.ue-varna.bg",
      "applyUrl": "https://ksp.ue-varna.bg/login"
